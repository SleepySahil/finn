# Copy to .env.local. Everything is optional: with no key FINN still triages filings,
# computes results first-cuts, signals and the numeric research — it just cannot read PDFs.

# Free key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Optional second free route for short prompts: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. By default FINN asks the API which Flash / Flash-Lite models exist and uses the newest stable ones.
# GEMINI_MODEL_FAST=
# GEMINI_MODEL_SMART=
# GROQ_MODEL=llama-3.3-70b-versatile
